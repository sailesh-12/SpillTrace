# Copy to `.env` (never commit it). Everything the pipeline needs today is KEY-FREE:
#   Sentinel-1 (Planetary Computer), Open-Meteo currents/wind, DMA AIS, GSHHG coastline.
# The variables below are OPTIONAL upgrades; the Data sources page shows whether each is set.

# Copernicus Marine (CMEMS) — https://data.marine.copernicus.eu/register
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# Copernicus Data Space Ecosystem — https://dataspace.copernicus.eu
CDSE_USERNAME=
CDSE_PASSWORD=

# Global Fishing Watch API (real AIS-derived vessel presence for Indian waters; used by ais.mode auto/real) — https://globalfishingwatch.org/our-apis/tokens
GFW_API_TOKEN=

# Indian-waters AIS provider (institutional / commercial)
INDIA_AIS_API_KEY=
